{
  "mcpServers": {
    "openviking": {
      "enabled": true,
      "type": "http",
      "url": "http://openviking:1933/mcp",
      "headers": {
        "X-API-Key": "17cb371236735c7469b933643d10ea6a"
      },
      "routing": {
        "mode": "prefer",
        "priority": 60,
        "keywords": [
          "记忆",
          "recall",
          "remember",
          "之前",
          "历史会话"
        ]
      }
    },
    "pacgate": {
      "enabled": true,
      "type": "http",
      "url": "http://pacgate-mcp:8000/mcp",
      "description": "Query pacgate's legal RAG knowledge base and external legal database connectors.",
      "routing": {
        "mode": "prefer",
        "priority": 60,
        "keywords": [
          "知识库",
          "RAG",
          "检索",
          "knowledge base"
        ]
      }
    },
    "firecrawl": {
      "enabled": true,
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "firecrawl-mcp"
      ],
      "env": {
        "FIRECRAWL_API_KEY": "fc-6b9cccd58ef249c99d9cc2cb445d9332"
      },
      "description": "Firecrawl — 网页抓取/搜索/爬取 (web scraping, search, crawl)",
      "routing": {
        "mode": "prefer",
        "priority": 55,
        "keywords": [
          "网页",
          "抓取",
          "爬取",
          "web",
          "scrape",
          "官网"
        ]
      }
    },
    "officecli": {
      "enabled": true,
      "type": "stdio",
      "command": "officecli",
      "args": [
        "mcp"
      ],
      "env": {
        "OFFICECLI_SKIP_UPDATE": "1"
      },
      "description": "OfficeCLI — Word/Excel/PPT 文档自动化 (create/read/edit/render docx/xlsx/pptx). Enabled: binary baked into deer-flow-pacgate 0.1.10+.",
      "routing": {
        "mode": "prefer",
        "priority": 55,
        "keywords": [
          "文档",
          "docx",
          "excel",
          "pptx",
          "表格",
          "生成报告"
        ]
      }
    },
