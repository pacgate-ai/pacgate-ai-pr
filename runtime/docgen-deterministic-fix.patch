+/// The filename a generation step should write.
+///
+/// A step may name it explicitly via `parameters.filename`. Otherwise derive one
+/// from the step name, which is what the workflow author already wrote for a
+/// human to read ("Generate project overview" -> `Generate_project_overview.docx`).
+/// The extension is forced to `.docx` so a step cannot ask `generate_docx` for a
+/// name the tool will then reject.
+fn step_filename(step: &WorkflowStep) -> String {
+    let explicit = step
+        .parameters
+        .get("filename")
+        .and_then(|v| v.as_str())
+        .map(str::trim)
+        .filter(|s| !s.is_empty());
+
+    let base = match explicit {
+        Some(name) => name.to_string(),
+        None => {
+            let cleaned: String = step
+                .name
+                .chars()
+                .map(|c| {
+                    if c.is_alphanumeric() || c == '-' || c == '_' {
+                        c
+                    } else {
+                        '_'
+                    }
+                })
+                .collect();
+            let trimmed = cleaned.trim_matches('_').to_string();
+            if trimmed.is_empty() {
+                "document".to_string()
+            } else {
+                trimmed
+            }
+        }
+    };
+
+    if base.to_ascii_lowercase().ends_with(".docx") {
+        base
+    } else {
+        format!("{base}.docx")
+    }
+}
