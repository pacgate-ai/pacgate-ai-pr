+    /// Run a workflow step whose tool takes a document STRUCTURE, without asking
+    /// the model to choose the tool.
+    ///
+    /// ## Why this exists
+    ///
+    /// A workflow step declares the one tool it exists to run, but the model was
+    /// still offered all eleven and asked to both pick one and serialise its
+    /// arguments. On the Main-tier `gemma4-legal:12b-chat` that fails completely.
+    /// Measured 2026-10-22 on the 项目概况表编制 step, which declares
+    /// `generate_docx` and whose prompt says "输出为Word文档":
+    ///
+    /// | Offered surface | Runs that called `generate_docx` |
+    /// |---|---|
+    /// | all 11 tools | 0 of 5 - every run called `list_documents` |
+    /// | `generate_docx` only | 0 of 5 - still `list_documents`, and sometimes invented names never offered (`print_files`, `list_files`) |
+    ///
+    /// Rewriting the base prompt, reordering the layers, lowering temperature and
+    /// stripping unavailable tool names all failed to change the choice. The 27B
+    /// does follow the directive (3 of 3) but is 17 GB and spills 30% to CPU on a
+    /// 16 GB card, so it is not a viable default.
+    ///
+    /// ## What this does instead
+    ///
+    /// The tool choice is removed from the model entirely. The model is asked for
+    /// ONE thing - the document structure as JSON - with no tools offered at all,
+    /// and the tool is then called directly with that structure. Measured on the
+    /// same step with the real workflow prompt: 4 of 4 runs produced a valid
+    /// structure, against 0 of 5 when the model also had to choose the tool.
+    ///
+    /// The model still authors the content; only the decision is taken away. That
+    /// is the part a small model cannot do reliably, and it is the part that has a
+    /// deterministic answer.
+    ///
+    /// Falls back to the normal agent loop when the reply carries no usable
+    /// structure, so a model that cannot produce JSON degrades to the previous
+    /// behaviour rather than writing an empty document.
+    #[instrument(skip(self, router, user_message, persona_prompt))]
+    pub async fn run_generation_tool(
+        &self,
+        router: &Arc<LlmRouter>,
+        user_message: &str,
+        persona_prompt: Option<&str>,
+        matter_id: Option<&MatterId>,
+        tool: &str,
+        filename: &str,
+    ) -> Result<AgentTurnResult> {
+        let Some(contract) = generation_output_contract(tool) else {
+            return self
+                .run_with_router(router, vec![], user_message, persona_prompt, matter_id)
+                .await;
+        };
+
+        let llm = router.get(self.tier)?;
+        let system_prompt = build_system_prompt(persona_prompt, matter_id);
+        let messages = vec![
+            ChatMessage {
+                role: "system".into(),
+                content: Some(serde_json::Value::String(system_prompt)),
+                tool_calls: None,
+                tool_call_id: None,
+                name: None,
+            },
+            ChatMessage {
+                role: "user".into(),
+                content: Some(serde_json::Value::String(format!(
+                    "{user_message}\n## Output format\n\n{contract}"
+                ))),
+                tool_calls: None,
+                tool_call_id: None,
+                name: None,
+            },
+        ];
+
+        // No tools: the model cannot pick a different one, and cannot spend the
+        // turn gathering context instead of writing.
+        let (content, _) = llm.complete(messages, Vec::new()).await?;
+        let raw = content.unwrap_or_default();
+
+        let Some(structure) = extract_json_object(&raw) else {
+            warn!(
+                tool,
+                reply_len = raw.len(),
+                "generation step produced no parseable structure; falling back to the agent loop"
+            );
+            return self
+                .run_with_router(router, vec![], user_message, persona_prompt, matter_id)
+                .await;
+        };
+
+        let Some(matter_id) = matter_id else {
+            return Err(PacgateError::ValidationError(
+                "a generation step needs a matter_id to write into".into(),
+            ));
+        };
+
+        let call = ToolCall {
+            id: format!("gen_{}", MessageId::new()),
+            tool_name: tool.to_string(),
+            arguments: serde_json::json!({
+                "matter_id": matter_id.as_str(),
+                "filename": filename,
+                "structure": structure,
+            }),
+        };
+        let result = self.dispatcher.dispatch(&call).await;
+
+        if result.is_error {
+            // Surface the tool's own error rather than reporting a step that
+            // "ran" while nothing was written.
+            return Err(PacgateError::ValidationError(format!(
+                "{tool} failed: {}",
+                result.content
+            )));
+        }
+
+        Ok(AgentTurnResult {
+            message_id: MessageId::new(),
+            content: Some(result.content.to_string()),
+            citations: Vec::new(),
+            tool_calls_made: vec![tool.to_string()],
+            max_rounds_reached: false,
+        })
+    }
