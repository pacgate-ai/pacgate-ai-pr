+/// Tools whose arguments are a document STRUCTURE the model must author.
+///
+/// These are the tools where asking the model to both choose the tool and
+/// serialise its arguments fails on a small model. See
+/// `run_generation_tool` for the measurement.
+pub fn is_generation_tool(name: &str) -> bool {
+    matches!(name, "generate_docx")
+}
+
+/// The JSON shape a generation tool expects, as a prompt fragment.
+///
+/// Kept next to `tool_definitions` so the two cannot drift: the schema the model
+/// is shown here must describe the same object the tool's own schema requires.
+fn generation_output_contract(tool: &str) -> Option<&'static str> {
+    match tool {
+        "generate_docx" => Some(
+            "Reply with ONLY a JSON object - no prose, no explanation, no code fence:\n\n\
+             {\"title\":\"<document title>\",\"sections\":[ ... ]}\n\n\
+             Each section is an object with a \"type\" field, one of:\n\
+             - {\"type\":\"heading\",\"level\":1,\"text\":\"...\"}   (level 1-3)\n\
+             - {\"type\":\"paragraph\",\"text\":\"...\"}\n\
+             - {\"type\":\"numbered_list\",\"items\":[\"...\"]}\n\
+             - {\"type\":\"bullet_list\",\"items\":[\"...\"]}\n\
+             - {\"type\":\"table\",\"headers\":[\"...\"],\"rows\":[[\"...\"]]}\n\
+             - {\"type\":\"page_break\"}\n\
+             - {\"type\":\"recital\",\"text\":\"...\"}\n\
+             - {\"type\":\"signature_page\",\"parties\":[{\"name\":\"...\",\"role\":\"...\"}]}\n",
+        ),
+        _ => None,
+    }
+}
+
+/// Pull a JSON object out of a model reply.
+///
+/// Models wrap JSON in a code fence, prefix it with "Here is the document:", or
+/// both. Rather than demand a format the model will not reliably honour, take the
+/// outermost balanced `{...}` and parse that. Returns `None` when no balanced
+/// object is present, so the caller can fall back instead of writing a document
+/// from a truncated blob.
+fn extract_json_object(raw: &str) -> Option<serde_json::Value> {
+    let start = raw.find('{')?;
+    let bytes = raw.as_bytes();
+    let mut depth = 0usize;
+    let mut in_string = false;
+    let mut escaped = false;
+    for (i, &b) in bytes.iter().enumerate().skip(start) {
+        if in_string {
+            if escaped {
+                escaped = false;
+            } else if b == b'\\' {
+                escaped = true;
+            } else if b == b'"' {
+                in_string = false;
+            }
+            continue;
+        }
+        match b {
+            b'"' => in_string = true,
+            b'{' => depth += 1,
+            b'}' => {
+                depth -= 1;
+                if depth == 0 {
+                    let slice = &raw[start..=i];
+                    return serde_json::from_str(slice).ok();
+                }
+            }
+            _ => {}
+        }
+    }
+    None
+}
