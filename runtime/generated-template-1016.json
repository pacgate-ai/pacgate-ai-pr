{
  "mcpServers": {
    "openviking": {
      "enabled": true,
      "type": "http",
      "url": "http://openviking:1933/mcp",
      "headers": {
        "X-API-Key": "${OPENVIKING_ROOT_API_KEY}"
      }
    },
    "pacgate": {
      "enabled": true,
      "type": "http",
      "url": "http://pacgate-mcp:8000/mcp",
      "description": "Query pacgate's legal RAG knowledge base and external legal database connectors."
    },
    "firecrawl": {
      "enabled": true,
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "firecrawl-mcp"],
      "env": {
        "FIRECRAWL_API_KEY": "${FIRECRAWL_API_KEY}"
      },
      "description": "Firecrawl — 网页抓取/搜索/爬取 (web scraping, search, crawl)"
    },
    "officecli": {
      "enabled": true,
      "type": "stdio",
      "command": "officecli",
      "args": ["mcp"],
      "env": {
        "OFFICECLI_SKIP_UPDATE": "1"
      },
      "description": "OfficeCLI — Word/Excel/PPT 文档自动化 (create/read/edit/render docx/xlsx/pptx). Enabled: binary baked into deer-flow-pacgate 0.1.10+."
    },
    "yuandian-law": {
      "enabled": true,
      "type": "http",
      "url": "https://open.chineselaw.com/mcp/law/stream",
      "headers": {
        "Accept": "application/json, text/event-stream",
        "Authorization": "Bearer ${YUANDIAN_API_KEY}"
      },
      "description": "元典 — 法律检索 (法规、法条、司法解释)"
    },
    "yuandian-case": {
      "enabled": true,
      "type": "http",
      "url": "https://open.chineselaw.com/mcp/case/stream",
      "headers": {
        "Accept": "application/json, text/event-stream",
        "Authorization": "Bearer ${YUANDIAN_API_KEY}"
      },
      "description": "元典 — 案例检索 (裁判文书、案例库)"
    },
    "yuandian-company": {
      "enabled": true,
      "type": "http",
      "url": "https://open.chineselaw.com/mcp/company/stream",
      "headers": {
        "Accept": "application/json, text/event-stream",
        "Authorization": "Bearer ${YUANDIAN_API_KEY}"
      },
      "description": "元典 — 企业信息 (工商登记、关联企业)"
    },
    "yuandian-securities": {
      "enabled": true,
      "type": "http",
      "url": "https://open.chineselaw.com/mcp/securities/stream",
      "headers": {
        "Accept": "application/json, text/event-stream",
        "Authorization": "Bearer ${YUANDIAN_API_KEY}"
      },
      "description": "元典 — 证券检索 (证券法规、监管文件)"
    },
    "pkulaw-law-search": {
      "enabled": true,
      "type": "http",
      "url": "https://apim-gateway.pkulaw.com/mcp-law-search-service",
      "headers": {
        "Accept": "application/json, text/event-stream",
        "Authorization": "Bearer ${PKULAW_API_KEY}"
      },
      "description": "北大法宝 — 法规语义检索"
    },
    "pkulaw-law-keyword": {
      "enabled": true,
      "type": "http",
      "url": "https://apim-gateway.pkulaw.com/mcp-law",
      "headers": {
        "Accept": "application/json, text/event-stream",
        "Authorization": "Bearer ${PKULAW_API_KEY}"
      },
      "description": "北大法宝 — 法规关键词检索"
    },
    "pkulaw-case-semantic-search": {
      "enabled": true,
      "type": "http",
      "url": "https://apim-gateway.pkulaw.com/mcp-case-search-service",
      "headers": {
        "Accept": "application/json, text/event-stream",
        "Authorization": "Bearer ${PKULAW_API_KEY}"
      },
      "description": "北大法宝 — 案例语义检索"
    },
    "pkulaw-case-keyword": {
      "enabled": true,
      "type": "http",
      "url": "https://apim-gateway.pkulaw.com/mcp-case",
      "headers": {
        "Accept": "application/json, text/event-stream",
        "Authorization": "Bearer ${PKULAW_API_KEY}"
      },
      "description": "北大法宝 — 案例关键词检索"
    },
    "pkulaw-law-item-keyword": {
      "enabled": true,
      "type": "http",
      "url": "https://apim-gateway.pkulaw.com/mcp-fatiao",
      "headers": {
        "Accept": "application/json, text/event-stream",
        "Authorization": "Bearer ${PKULAW_API_KEY}"
      },
      "description": "北大法宝 — 法条关键词检索"
    },
    "pkulaw-law-recognition": {
      "enabled": true,
      "type": "http",
      "url": "https://apim-gateway.pkulaw.com/law_recognition",
      "headers": {
        "Accept": "application/json, text/event-stream",
        "Authorization": "Bearer ${PKULAW_API_KEY}"
      },
      "description": "北大法宝 — 法规识别"
    },
    "pkulaw-case-number-recognition": {
      "enabled": true,
      "type": "http",
      "url": "https://apim-gateway.pkulaw.com/case_number_recognition",
      "headers": {
        "Accept": "application/json, text/event-stream",
        "Authorization": "Bearer ${PKULAW_API_KEY}"
      },
      "description": "北大法宝 — 案号识别"
    },
    "pkulaw-citation-validator": {
      "enabled": true,
      "type": "http",
      "url": "https://apim-gateway.pkulaw.com/pku_citation_validator",
      "headers": {
        "Accept": "application/json, text/event-stream",
        "Authorization": "Bearer ${PKULAW_API_KEY}"
      },
      "description": "北大法宝 — 引文核验"
    },
    "pkulaw-doc-link": {
      "enabled": true,
      "type": "http",
      "url": "https://apim-gateway.pkulaw.com/add-doc-link",
      "headers": {
        "Accept": "application/json, text/event-stream",
        "Authorization": "Bearer ${PKULAW_API_KEY}"
      },
      "description": "北大法宝 — 文档关联"
    },
    "qcc-company": {
      "enabled": false,
      "type": "http",
      "url": "https://agent.qcc.com/mcp/company/stream",
      "headers": {
        "Accept": "application/json, text/event-stream",
        "Authorization": "Bearer ${QCC_API_KEY}"
      },
      "description": "企查查 — 工商信息 (企业基本信息、股东、注册资本)"
    },
    "qcc-risk": {
      "enabled": false,
      "type": "http",
      "url": "https://agent.qcc.com/mcp/risk/stream",
      "headers": {
        "Accept": "application/json, text/event-stream",
        "Authorization": "Bearer ${QCC_API_KEY}"
      },
      "description": "企查查 — 经营风险 (行政处罚、失信、被执行)"
    },
    "qcc-ipr": {
      "enabled": false,
      "type": "http",
      "url": "https://agent.qcc.com/mcp/ipr/stream",
      "headers": {
        "Accept": "application/json, text/event-stream",
        "Authorization": "Bearer ${QCC_API_KEY}"
      },
      "description": "企查查 — 知识产权 (专利、商标、著作权)"
    },
    "qcc-operation": {
      "enabled": false,
      "type": "http",
      "url": "https://agent.qcc.com/mcp/operation/stream",
      "headers": {
        "Accept": "application/json, text/event-stream",
        "Authorization": "Bearer ${QCC_API_KEY}"
      },
      "description": "企查查 — 经营信息 (年报、经营异常)"
    },
    "qcc-history": {
      "enabled": false,
      "type": "http",
      "url": "https://agent.qcc.com/mcp/history/stream",
      "headers": {
        "Accept": "application/json, text/event-stream",
        "Authorization": "Bearer ${QCC_API_KEY}"
      },
      "description": "企查查 — 变更历史 (工商变更记录)"
    },
    "qcc-executive": {
      "enabled": false,
      "type": "http",
      "url": "https://agent.qcc.com/mcp/executive/stream",
      "headers": {
        "Accept": "application/json, text/event-stream",
        "Authorization": "Bearer ${QCC_API_KEY}"
      },
      "description": "企查查 — 高管信息 (董监高、主要人员)"
    },
    "qcc-legal-regulation": {
      "enabled": false,
      "type": "http",
      "url": "https://agent.qcc.com/mcp/regulation/stream",
      "headers": {
        "Accept": "application/json, text/event-stream",
        "Authorization": "Bearer ${QCC_API_KEY}"
      },
      "description": "企查查 — 法律法规 (监管法规检索)"
    },
    "qcc-legal-case": {
      "enabled": false,
      "type": "http",
      "url": "https://agent.qcc.com/mcp/case/stream",
      "headers": {
        "Accept": "application/json, text/event-stream",
        "Authorization": "Bearer ${QCC_API_KEY}"
      },
      "description": "企查查 — 诉讼记录 (企业涉诉、裁判文书)"
    },
    "qcc-tender": {
      "enabled": false,
      "type": "http",
      "url": "https://agent.qcc.com/mcp/tender/stream",
      "headers": {
        "Accept": "application/json, text/event-stream",
        "Authorization": "Bearer ${QCC_API_KEY}"
      },
      "description": "企查查 — 招投标 (招标、中标信息)"
    },
    "qcc-document": {
      "enabled": false,
      "type": "http",
      "url": "https://agent.qcc.com/mcp/document/stream",
      "headers": {
        "Accept": "application/json, text/event-stream",
        "Authorization": "Bearer ${QCC_API_KEY}"
      },
      "description": "企查查 — 企业文档 (年报、招标、专利、商标)"
    },
    "qcc-document-mcp": {
      "enabled": false,
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "qcc-document-mcp"],
      "env": {
        "QCC_DOCUMENT_AUTHORIZATION": "Bearer ${QCC_API_KEY}"
      },
      "description": "企查查 — 企业文档 MCP (stdio)"
    },
    "vaquill": {
      "enabled": true,
      "type": "http",
      "url": "https://mcp.vaquill.ai/s/${VAQUILL_API_KEY}",
      "headers": {
        "Accept": "application/json, text/event-stream"
      },
      "description": "Vaquill — 美国法律检索 (US Legal Research)"
    },
    "ansvar": {
      "enabled": false,
      "type": "http",
      "url": "https://gateway.ansvar.eu/mcp",
      "headers": {
        "Accept": "application/json, text/event-stream",
        "Authorization": "Bearer ${ANSVAR_API_KEY}"
      },
      "description": "Ansvar — 欧盟合规 (EU Compliance MCP)"
    }
  }
}